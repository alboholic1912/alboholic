NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# For generating with OpenAI models in the Studio: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: the site's public address once it has a custom domain, e.g. https://alboholic.com
NEXT_PUBLIC_SITE_URL=
# Instagram scheduler. Supabase > Project Settings > API keys > service_role (secret). Server only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. The scheduler sends it to /api/instagram/cron (see supabase/instagram.sql).
CRON_SECRET=
